{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SgtPooki/harness-ratchet/finding.schema.json",
  "title": "Finding format v1 (issue #5, amended 2026-08-25)",
  "type": "object",
  "required": ["format_version", "digest", "kind", "slug", "created", "license",
               "submitter_identity", "harness", "declared_surface", "operations",
               "claim"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "digest": {
      "description": "hr-fd-1 over the finding directory, this file included as canonical JSON with this field null (the #5 amendment self-reference rule)",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {"enum": ["improvement", "negative-result"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "target_finding": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created": {"type": "string", "format": "date"},
    "license": {"type": "string", "minLength": 1},
    "submitter_identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*:.+$"},
    "harness": {
      "type": "object",
      "required": ["id", "version", "surface_digest"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "surface_digest": {
          "description": "sha256 of the canonical JSON of the operation (#5 point 3)",
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "declared_surface": {"enum": ["config-overlay", "model-param", "rules"]},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "payload"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["config-overlay", "model-param", "rules"]},
          "payload": {"type": "object"}
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["kit_commit", "decision", "improved_axes", "gate", "k",
                   "baseline_label", "candidate_label", "pack", "split",
                   "baseline_harness", "channel_liveness", "model_fingerprint",
                   "runtime_envelope", "sweep_cost"],
      "additionalProperties": false,
      "properties": {
        "kit_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "decision": {"enum": ["PROMOTE", "REJECT"]},
        "improved_axes": {"type": "array", "items": {"type": "string"}},
        "gate": {
          "type": "object",
          "required": ["gate_version", "min_k", "effect_threshold"],
          "additionalProperties": false,
          "properties": {
            "gate_version": {"type": "integer"},
            "min_k": {"type": "integer", "minimum": 2},
            "effect_threshold": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "k": {"type": "integer", "minimum": 4,
              "description": "final k; screening sweeps are not claim-grade (#12 decision 4)"},
        "baseline_label": {"type": "string"},
        "candidate_label": {"type": "string"},
        "pack": {
          "type": "object",
          "required": ["name", "digest", "vintage"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "vintage": {
              "type": "object",
              "required": ["number", "date"],
              "additionalProperties": false,
              "properties": {"number": {"type": "integer"},
                             "date": {"type": "string", "format": "date"}}
            },
            "url": {"type": "string"}
          }
        },
        "split": {
          "type": "object",
          "required": ["algorithm", "digest", "split_version", "roles"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {"const": "hr-sd-1"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "split_version": {"type": "integer"},
            "roles": {
              "type": "object",
              "required": ["held_in", "held_out", "sentinel"],
              "additionalProperties": false,
              "properties": {
                "held_in": {"type": "array", "items": {"type": "string"}},
                "held_out": {"type": "array", "items": {"type": "string"}},
                "sentinel": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "baseline_harness": {
          "type": "object",
          "required": ["standing_overlays"],
          "additionalProperties": false,
          "properties": {
            "standing_overlays": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "additionalProperties": false,
                "properties": {"path": {"type": "string"},
                               "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
              }
            }
          }
        },
        "channel_liveness": {
          "oneOf": [
            {"type": "object",
             "required": ["method", "observed", "date"],
             "additionalProperties": false,
             "properties": {"method": {"type": "string"},
                            "observed": {"type": "boolean"},
                            "date": {"type": "string", "format": "date"}}},
            {"type": "object",
             "required": ["not_required"],
             "additionalProperties": false,
             "properties": {"not_required": {"type": "string", "minLength": 1}}}
          ]
        },
        "model_fingerprint": {
          "type": "object",
          "required": ["algorithm", "weights", "family", "family_source"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {"const": "hr-mf-1"},
            "weights": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "family": {"type": "string", "minLength": 1},
            "family_source": {"enum": ["inferred", "operator"]},
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {"enum": ["hf", "ollama", "local"]},
                "repo": {"type": "string"},
                "revision": {"type": "string"},
                "file_sha256": {"type": "string"},
                "quant": {"type": "string"}
              }
            }
          }
        },
        "runtime_envelope": {
          "type": "object",
          "required": ["engine", "engine_version", "quantization",
                       "context_window", "max_tokens", "sampling",
                       "omp_model_alias", "timeout_s", "concurrency"],
          "additionalProperties": false,
          "properties": {
            "engine": {"type": "string"},
            "engine_version": {"type": "string"},
            "quantization": {"type": "string",
                             "description": "load-time transform only; baked-in quant lives in the weights digest"},
            "context_window": {"type": "integer"},
            "max_tokens": {"type": "integer"},
            "sampling": {"type": "object"},
            "omp_model_alias": {"type": "string"},
            "timeout_s": {"type": "integer"},
            "concurrency": {"type": "integer", "minimum": 1}
          }
        },
        "sweep_cost": {
          "type": "object",
          "required": ["baseline", "candidate"],
          "additionalProperties": false,
          "properties": {"baseline": {"type": "object"},
                         "candidate": {"type": "object"}}
        }
      }
    }
  }
}
