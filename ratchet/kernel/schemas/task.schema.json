{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SgtPooki/harness-ratchet/task.schema.json",
  "title": "Per-task metadata (pack format v1, issue #3)",
  "type": "object",
  "required": ["id", "requires", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "requires": {
      "type": "array",
      "items": {"enum": ["python3", "uv", "node", "bash", "git"]},
      "uniqueItems": true
    },
    "surfaces": {
      "type": "object",
      "required": ["agent", "scoring", "admission"],
      "additionalProperties": false,
      "properties": {
        "agent": {"$ref": "#/$defs/surface"},
        "scoring": {"$ref": "#/$defs/surface"},
        "admission": {"$ref": "#/$defs/surface"}
      }
    },
    "difficulty_hint": {"type": "string"}
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["encryption"],
      "additionalProperties": false,
      "properties": {
        "encryption": {"enum": ["plaintext", "role-keyed"]}
      }
    }
  }
}
