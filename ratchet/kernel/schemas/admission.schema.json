{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SgtPooki/harness-ratchet/admission.schema.json",
  "title": "Per-task admission record (pack format v1, issue #3): the miner's audit attestation. Never authoritative; consumers re-execute the audit.",
  "type": "object",
  "required": ["task", "oracle", "sabotage", "miner", "minted"],
  "additionalProperties": false,
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "oracle": {
      "type": "object",
      "required": ["unmodified_fails", "solution_passes", "sabotage_fails"],
      "additionalProperties": false,
      "properties": {
        "unmodified_fails": {"type": "boolean"},
        "solution_passes": {"type": "boolean"},
        "sabotage_fails": {"type": ["boolean", "null"]}
      }
    },
    "sabotage": {"enum": ["present", "absent-grandfathered"]},
    "mutants": {
      "type": ["object", "null"],
      "required": ["killed", "total"],
      "additionalProperties": false,
      "properties": {
        "killed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "stability_runs": {"type": ["integer", "null"], "minimum": 0},
    "miner": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "minted": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {"type": ["string", "null"]}
  }
}
